# Database
DATABASE_URL=postgresql+asyncpg://jobhunter:jobhunter@postgres:5432/jobhunter
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=change-this-database-password

# LLM: deepseek, openrouter or disabled (deterministic local scoring)
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45

# Intent classification runs before profile matching. Ambiguous messages use the
# configured LLM only when enabled; unknown/failures are always filtered.
INTENT_CLASSIFIER_ENABLED=true
INTENT_CLASSIFIER_MODEL=
INTENT_DETERMINISTIC_DEMAND_CONFIDENCE=0.86
INTENT_DETERMINISTIC_REJECT_CONFIDENCE=0.82
INTENT_SEMANTIC_DEMAND_CONFIDENCE=0.80
INTENT_SEMANTIC_REJECT_CONFIDENCE=0.72

# Voice onboarding is transcribed locally. The model is downloaded once into /data/whisper.
VOICE_TRANSCRIPTION_ENABLED=true
VOICE_TRANSCRIPTION_MODEL=base
VOICE_TRANSCRIPTION_CACHE_DIR=/data/whisper

# Telegram user account (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PROXY_HOST=
TELEGRAM_PROXY_PORT=1080
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
TELEGRAM_SESSION_PATH=/data/jobhunter

# Telegram bot created via @BotFather; owner id receives admin defaults
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=vzyal_zakaz_bot
TELEGRAM_OWNER_ID=
# HTTPS URL used by Telegram buttons, e.g. https://app.example.com/app
MINI_APP_URL=

# Multi-user registration: open, invite or closed
REGISTRATION_MODE=invite
REGISTRATION_INVITE_CODE=change-this-long-random-code
MAX_USERS=100
ONBOARDING_BACKFILL_LIMIT=200

# Legacy Telegram bootstrap token: use a separate random secret in production.
MINI_APP_SESSION_SECRET=change-this-to-a-long-random-secret
MINI_APP_AUTH_MAX_AGE_SECONDS=86400
MINI_APP_SESSION_TTL_SECONDS=604800
WEB_LOGIN_TICKET_TTL_SECONDS=600
WEB_SESSION_TTL_SECONDS=2592000
WEB_SESSION_COOKIE_NAME=vzyalzakaz_session
EXTENSION_LINK_TICKET_TTL_SECONDS=300
EXTENSION_SESSION_TTL_SECONDS=7776000
EXTENSION_COMMAND_TTL_SECONDS=900
EXTENSION_OFFLINE_AFTER_SECONDS=120
# Set after Chrome Web Store assigns the permanent extension id.
NEXT_PUBLIC_EXTENSION_ID=
# Local-only browser preview. Never enable this on a public server.
ALLOW_DEV_AUTH=false
DEV_TELEGRAM_USER_ID=

# Billing: use test-store credentials locally. Never expose the secret in frontend code.
PUBLIC_BASE_URL=http://localhost:8010
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
BILLING_PRO_MONTHLY_PRICE_RUB=990.00

# Runtime
CONFIG_DIR=/app/config
LOG_LEVEL=INFO
ENABLE_SCHEDULER=true
ENABLE_TELEGRAM_COLLECTOR=true
ENABLE_TELEGRAM_BOT=true
WEB_CONCURRENCY=1
JOBHUNTER_PORT=8000
